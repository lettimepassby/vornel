{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vornel",
  "version": "0.1.6",
  "identifier": "com.lettimepassby.vornel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vornel",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 23
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: vornel-font: http://vornel-font.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "跨平台 SSH / SFTP / RDP 客户端",
    "copyright": "Copyright (c) 2026 lettimepassby · PolyForm Noncommercial 1.0.0",
    "licenseFile": "../../../LICENSE.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.4"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNTkwQjA0OENGRUVDQTAKUldTZzdQNk1CQXRaYkR4MURGOElMODNGbHE5SWUwcURveDB3ZzJscHdGSlFtZVJVbFZudGR5WEcK",
      "endpoints": [
        "https://github.com/lettimepassby/vornel/releases/latest/download/latest.json"
      ]
    }
  }
}
