{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "桌面端专用权限：应用内更新与更新后重启（iOS 走 App Store，没有这两个插件）",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart"
  ]
}
